# Copy this file to .env and fill in your values.
# .env is gitignored and never committed.

# ── Claude (Anthropic) ────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=your-anthropic-api-key-here
CLAUDE_MODEL=claude-3-5-sonnet-20241022

# ── Paths ─────────────────────────────────────────────────────────────────────
DOCS_DIR=docs
DB_DIR=chroma_db

# ── Chunking ──────────────────────────────────────────────────────────────────
CHUNK_SIZE=800
CHUNK_OVERLAP=100

# ── Retrieval ─────────────────────────────────────────────────────────────────
TOP_K=5

# ── Embedding model ───────────────────────────────────────────────────────────
EMBEDDING_MODEL=all-MiniLM-L6-v2
